{
  "name": "stockpro",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "test": "npm run test:db && npm run test:imports",
    "test:db": "node tests/team-database.mjs",
    "test:browser": "node tests/browser.mjs",
    "format:check": "prettier --check src tests index.html .oxlintrc.json",
    "format": "prettier --write src tests index.html .oxlintrc.json",
    "test:legacy-db": "node tests/database.mjs",
    "test:imports": "node tests/imports.mjs",
    "test:import-improvements": "node tests/import-improvements.mjs",
    "check:supabase": "node scripts/check-supabase.mjs",
    "check:supabase:auth": "node scripts/check-supabase-authenticated.mjs",
    "test:demo": "node tests/demo-seed.mjs",
    "test:catalog-status": "node tests/catalog-status.mjs"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.9.1",
    "@supabase/supabase-js": "^2.118.0",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-query": "^5.104.3",
    "exceljs": "4.4.0",
    "lucide-react": "^1.57.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-hook-form": "^7.90.0",
    "react-router-dom": "^7.18.4",
    "recharts": "^3.10.1",
    "tailwindcss": "^4.3.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.10",
    "@playwright/test": "1.64.1",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "oxlint": "^1.81.0",
    "prettier": "3.9.10",
    "typescript": "~6.0.2",
    "vite": "^8.3.0"
  },
  "overrides": {
    "exceljs": {
      "uuid": "11.1.1"
    }
  }
}
